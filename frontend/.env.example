# Configuración del frontend (Django). Copiar a `.env`:
#     cp .env.example .env

# Clave secreta de Django (firma de sesiones y tokens CSRF). Genera una
# distinta para producción.
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion

# False en producción. Con True Django sirve archivos estáticos por su cuenta.
DJANGO_DEBUG=True

# Hosts permitidos, separados por coma. En Vercel no hace falta configurarlo:
# VERCEL_URL y VERCEL_PROJECT_PRODUCTION_URL se agregan automáticamente, junto
# con el comodín `.vercel.app` (ver config/settings.py).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes de confianza para el CSRF (necesario para el login por HTTPS en
# producción). Separados por coma y con esquema, ej:
#     DJANGO_CSRF_TRUSTED_ORIGINS=https://mi-frontend.vercel.app
# En Vercel los dominios del despliegue ya se agregan solos.
DJANGO_CSRF_TRUSTED_ORIGINS=

# URL del backend FastAPI. En producción es el dominio del backend en Vercel.
FASTAPI_BASE_URL=http://127.0.0.1:8000

# Base de datos. Vacía = SQLite local (`frontend/db.sqlite3`), cómodo para el
# taller.
#
# El frontend NO la necesita para funcionar: la sesión (el JWT) viaja en una
# cookie firmada, así que en Vercel se despliega sin ninguna base de datos. Solo
# hace falta si vas a usar el `/admin/` de Django; en ese caso apunta al mismo
# Postgres administrado que el backend y crea sus tablas una vez:
#     DATABASE_URL=postgresql://usuario:clave@host/neondb?sslmode=require
#     python manage.py migrate
DATABASE_URL=
