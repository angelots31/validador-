# Configuración del backend (FastAPI). Copiar a `.env`:
#     cp .env.example .env
#
# Todas estas variables tienen un valor por defecto en app/core/config.py,
# pensado para desarrollo local. En producción hay que cambiarlas.

# Base de datos. Vacía = SQLite local (`backend/app.db`), que es lo cómodo
# para el taller. En producción se apunta a un Postgres administrado (Neon):
#     DATABASE_URL=postgresql://usuario:clave@host/neondb?sslmode=require
# Se acepta también el esquema `postgres://` que entregan algunos
# proveedores: el código lo normaliza al driver psycopg 3.
DATABASE_URL=

# Clave con la que se firman los JWT. En producción usa una cadena larga y
# aleatoria; si alguien la conoce, puede fabricar tokens válidos.
JWT_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Algoritmo de firma del JWT.
JWT_ALGORITHM=HS256

# Minutos de validez del token de acceso.
JWT_EXPIRE_MINUTES=60

# Orígenes permitidos para CORS, separados por coma. Normalmente no hace falta
# tocarlo: el frontend Django llama a esta API desde el servidor, no desde el
# navegador, así que CORS no entra en juego en el flujo de la aplicación.
# CORS_ORIGINS=https://mi-frontend.vercel.app
